generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum SessionType {
  WORK
  BREAK
  LONG_BREAK
}



model StudySession {
  id          String    @id @default(uuid())
  userId      String
  startTime   DateTime  @default(now())
  endTime     DateTime? // Optional — can be null if session still in progress
  durationMin Int       @default(0) // Can be updated per minute or on finish

  type      SessionType // 'WORK' | 'BREAK' | 'LONG_BREAK'
  completed Boolean     @default(false) // Whether the session was fully finished
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([startTime])
  @@index([durationMin])
}

model NoteGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?  @default("#3b82f6") // Default blue color
  icon      String?  @default("📁") // Default folder icon
  order     Int      @default(0) // For custom ordering
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]

  @@unique([id, userId])
  @@index([userId])
  @@index([order])
}

model Note {
  id          String     @id @default(uuid())
  userId      String
  groupId     String
  title       String
  content     String     // Store note content (supports markdown/rich text)
  format      String     @default("markdown") // markdown, richtext, plain
  isPinned    Boolean    @default(false)
  isFavorite  Boolean    @default(false)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  group       NoteGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId])
  @@index([groupId])
  @@index([isPinned])
  @@index([order])
}

model StudySchedule {
  id        String   @id @default(uuid())
  userId    String
  weekData  String   // JSON string containing the full week schedule
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId]) // One schedule per user
  @@index([userId])
}
